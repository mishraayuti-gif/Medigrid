# Server & Application
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# MongoDB Database (optional in sandbox; falls back to local persisted store if unreachable)
MONGODB_URI="mongodb://localhost:27017/mindcare_ai"

# Ollama LLM (primary AI provider - local http://localhost:11434 or https://ollama.com)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
OLLAMA_API_KEY=""
OLLAMA_TIMEOUT_MS=25000

# Python FastAPI Posture & AI Microservice
AI_SERVICE_URL="http://localhost:8000"
